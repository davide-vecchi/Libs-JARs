<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>djavalibraries</groupId>
	<artifactId>dsax</artifactId>
	<version>2.2.2-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencies>

        <!-- Beginning of DJavaLibraries -->

        <dependency>
            <groupId>djavalibraries</groupId>
			<artifactId>dlog</artifactId>
            <version>2.3.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>djavalibraries</groupId>
			<artifactId>dutil</artifactId>
			<version>2.3.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>djavalibraries</groupId>
			<artifactId>dfile</artifactId>
			<version>2.4.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>djavalibraries</groupId>
			<artifactId>dxml</artifactId>
			<version>2.2.2-SNAPSHOT</version>
        </dependency>

        <!-- End of DJavaLibraries -->
        
        <!-- https://mvnrepository.com/artifact/org.testng/testng -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
            <scope>test</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/jakarta.validation/jakarta.validation-api -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>
        
        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
		
		<!-- See https://www.slf4j.org/codes.html#noProviders -->
		<!-- See https://www.slf4j.org/codes.html#StaticLoggerBinder -->
		<!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-reload4j -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-reload4j</artifactId>
			<version>2.0.18</version>
			<scope>compile</scope>
		</dependency>

    </dependencies>
    
    <build>
        <plugins>
            <!-- Without this, the build fails on Mac {2026-01-15 Davide} : -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
					<encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
	
	<distributionManagement>
		
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/davide-vecchi/DSAX</url>
		</repository>
	
	</distributionManagement>

</project>
