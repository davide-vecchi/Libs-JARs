<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<groupId>djavalibraries</groupId>
	<artifactId>dgoogledocs</artifactId>
	<version>2.2.0</version>
	
	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.encoding>UTF-8</maven.compiler.encoding>
	</properties>
	
	<dependencies>
		
		<!-- Beginning google-sheets-java-client -->
		
		<!-- https://mvnrepository.com/artifact/com.google.api-client/google-api-client -->
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>2.7.0</version>
		</dependency>
		<!-- https://www.baeldung.com/google-sheets-java-client
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>1.23.0</version>
		</dependency>
		-->
		
		<!-- https://mvnrepository.com/artifact/com.google.oauth-client/google-oauth-client-jetty -->
		<dependency>
			<groupId>com.google.oauth-client</groupId>
			<artifactId>google-oauth-client-jetty</artifactId>
			<version>1.36.0</version>
		</dependency>
		<!-- https://www.baeldung.com/google-sheets-java-client
		<dependency>
			<groupId>com.google.oauth-client</groupId>
			<artifactId>google-oauth-client-jetty</artifactId>
			<version>1.23.0</version>
		</dependency>
		-->
		
		<!-- https://mvnrepository.com/artifact/com.google.apis/google-api-services-sheets -->
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-sheets</artifactId>
			<version>v4-rev612-1.25.0</version>
		</dependency>
		<!-- https://www.baeldung.com/google-sheets-java-client
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-sheets</artifactId>
			<version>v4-rev493-1.23.0</version>
		</dependency>
		-->
		
		<!-- End google-sheets-java-client -->
		
		<!-- Beginning of DJavaLibraries -->
		
		<dependency>
			<groupId>djavalibraries</groupId>
			<artifactId>dlog</artifactId>
            <version>2.2.0</version>
		</dependency>
		
		<dependency>
			<groupId>djavalibraries</groupId>
			<artifactId>dutil</artifactId>
			<version>2.2.0</version>
		</dependency>
		
		<dependency>
			<groupId>djavalibraries</groupId>
			<artifactId>dtestng</artifactId>
			<version>2.1.0</version>
			<scope>test</scope>
		</dependency>
		
		<!-- End of DJavaLibraries -->
		
	</dependencies>
	
</project>
